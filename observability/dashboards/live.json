{
  "uid": "task-api-live",
  "title": "Task API Live Telemetry",
  "schemaVersion": 41,
  "editable": false,
  "timezone": "utc",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Gateway error ratio over 30 seconds",
      "description": "The alert uses this query and requires 10 seconds above 20%.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(lab_task_gateway_requests_total{status_class=\"5xx\"}[30s])) / clamp_min(sum(rate(lab_task_gateway_requests_total[30s])), 0.000001)",
          "legendFormat": "5xx ratio",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Gateway requests per second by status class",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(lab_task_gateway_requests_total[30s])",
          "legendFormat": "{{status_class}}",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Gateway p95 latency over 30 seconds",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lab_task_gateway_request_duration_seconds_bucket[30s])))",
          "legendFormat": "p95",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Gateway request log",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "{service_name=\"task-gateway\",exercise=\"live\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "enableLogDetails": true
      }
    }
  ]
}
